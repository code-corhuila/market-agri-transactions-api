<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>co.edu.corhuila.marketagri</groupId>
        <artifactId>transactions-api</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>transactions-adapters</artifactId>
    <description>Inbound HTTP adapter and outbound adapters. They implement the ports of the core.</description>

    <!-- The broker client is the plain RabbitMQ Java client (version managed by Spring Boot): no
         Spring AMQP, so nothing can declare exchanges or queues (the topology belongs to infra). -->
    <dependencies>
        <dependency>
            <groupId>co.edu.corhuila.marketagri</groupId>
            <artifactId>transactions-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Plain JDBC with the Hikari pool: no JPA, the schema belongs to transactions-db (ADR-011). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- Compile scope: the adapter reads the violated constraint from PSQLException (D-21). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <dependency>
            <groupId>com.rabbitmq</groupId>
            <artifactId>amqp-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
