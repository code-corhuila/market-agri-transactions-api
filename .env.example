# market-agri-transactions-api — every variable this repository reads.
# Copy to .env (ignored by git) for a local run. Placeholders only: never commit real values.

# Read by application.yml: HTTP port inside the container
PORT=8080

# Read by application.yml: PostgreSQL of market-agri-infra, as transactions_app (never the administrator)
DATABASE_URL=jdbc:postgresql://postgres:5432/market_agri
DATABASE_USER=transactions_app
DATABASE_PASSWORD=<password>

# Read by the integration tests (./mvnw verify -Pintegration); scripts/test-database.sh prints it.
# When it is not set, the integration tests are skipped (Anexo C).
# TEST_DATABASE_URL=jdbc:postgresql://localhost:55433/market_agri?user=transactions_app&password=<password>

# Read by application.yml: tokens of auth, validated locally (ADR-020). Only the public key.
# JWT_PUBLIC_KEY is the PEM on one line with literal \n (market-agri-infra/scripts/dev-keys.sh
# writes it); JWT_PUBLIC_KEY_FILE, a file with the PEM, is used when JWT_PUBLIC_KEY is empty.
JWT_ISSUER=market-agri-auth
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n<base64>\n-----END PUBLIC KEY-----
# JWT_PUBLIC_KEY_FILE=/run/secrets/jwt-public-key.pem

# Read by application.yml: payment provider (ADR-019). wompi needs the two WOMPI_* keys of the
# sandbox account; fake needs none. The buyer comes back to PUBLIC_BASE_URL/transacciones/<id>.
PAYMENT_GATEWAY=<fake|wompi>
PUBLIC_BASE_URL=http://localhost:8001
WOMPI_PUBLIC_KEY=<pub_test_...>
WOMPI_INTEGRITY_SECRET=<test_integrity_...>
# The checksum of Wompi's events (E-43); without it every event answers 400 INVALID_SIGNATURE.
WOMPI_EVENTS_SECRET=<test_events_...>

# Arrive with their use cases (not read yet):
#   D4  WOMPI_PRIVATE_KEY=<prv_test_...>   WOMPI_API_URL=https://sandbox.wompi.co/v1   (ADR-019)

# Read by deploy/compose.yml (from the market-agri-infra env file)
ENV=<dev|qa|main>
